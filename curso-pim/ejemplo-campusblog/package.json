{
    "name": "campusblog-api",
    "version": "1.0.0",
    "description": "API de ejemplo del curso PIM de DAW: CampusBlog (Node + Express + SQLite).",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "node --test --no-warnings \"tests/*.test.js\"",
        "test:e2e": "playwright test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "prepare": "husky || true",
        "css": "tailwindcss -i src-css/input.css -o public/styles.css --minify",
        "dev:seed": "SEED=1 node --watch src/server.js"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.3.0",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "swagger-ui-express": "^5.0.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^3.4.19"
    },
    "lint-staged": {
        "*.{js,json,css,md,html}": "prettier --write",
        "*.js": "eslint --fix"
    }
}
